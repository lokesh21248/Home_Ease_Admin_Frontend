{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://3.108.55.219:8080/api/:path*"
    },
    {
      "source": "/upload/:path*",
      "destination": "http://3.108.55.219:8080/upload/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
